   "cer:header": {
    "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON",
    "@value": "{\"authored_applied\": [], \"completeness_disclosure\": \"Registry-based prescreening: the approved protocol and amendments were not available. A registry excerpt is a discovery source, not proof that all enrollment requirements are present.\", \"conflicts\": [], \"ctrp_biomarker_contract\": {\"note\": \"No CTRP structured biomarker object ingested -> registry biomarker coverage is UNKNOWN, not 'no biomarker restriction'. Biomarker predicates below are interpreted from free text.\", \"status\": \"not_supplied\"}, \"inventory\": {\"criteria_total\": 22, \"exclusion\": 13, \"flagged_nodes\": 10, \"inclusion\": 9, \"leaf_nodes\": 25, \"leaves_by_computability\": {\"human_judgment\": 2, \"structured_computable\": 9, \"text_dependent\": 14}, \"typed_predicates\": 9}, \"lifecycle\": {\"note\": \"Draft only: not reviewed; not executable for screening.\", \"status\": \"draft\"}, \"review_summary\": {\"criteria\": 22, \"open_conflicts\": [], \"pending\": [\"Demo-min-age\", \"Inc-b1\", \"Inc-b2\", \"Inc-b3\", \"Inc-b4\", \"Inc-b5\", \"Inc-b6\", \"Inc-b7\", \"Inc-b8\", \"Exc-b1\", \"Exc-b2\", \"Exc-b3\", \"Exc-b4\", \"Exc-b5\", \"Exc-b6\", \"Exc-b7\", \"Exc-b8\", \"Exc-b9\", \"Exc-b10\", \"Exc-b11\", \"Exc-b12\", \"Exc-b13\"], \"validated\": 0}, \"schema_version\": \"cer-draft-0.1\", \"scope_items\": [], \"scopes\": [[]], \"source\": {\"content_sha256\": \"e9341b774e5cc8adbc6574f0dce5753c0d33cf3f174a3cdcea14beebc48f241c\", \"demographics\": {\"healthy_volunteers\": false, \"maximum_age\": null, \"minimum_age\": \"18 Years\", \"sex\": \"ALL\"}, \"nct_id\": \"NCT06357533\", \"overall_status\": \"RECRUITING\", \"protocol_baseline\": \"registry_excerpt\", \"registry\": \"ClinicalTrials.gov\", \"retrieved_at\": \"2026-10-06T01:30:00Z\", \"retrieved_via\": \"mcp:Clinical_Trials.get_trial_details\", \"source_role\": \"curated_registry_input (pilot proxy for Source B: the approved protocol document was not available)\", \"source_type\": \"B\", \"text_normalized\": \"Inclusion Criteria:\\n\\n* Histologically or cytologically documented non-squamous NSCLC.\\n* Stage IIIB or IIIC or Stage IV metastatic NSCLC (according to Edition 8 of the AJCC staging manual) not amenable to curative surgery or definitive chemoradiation.\\n* Absence of sensitising EGFR mutations, and ALK and ROS1 rearrangements, and absence of documented local test result for any other known genomic alteration for which there are locally approved and available targeted first-line therapies.\\n* Must provide tumor sample to determine PD-L1 status, TROP2 status and other biomarkers.\\n* Known tumour PD-L1 expression status defined as TC ≥ 50%\\n* At least one lesion, not previously irradiated that qualifies as a RECIST 1.1 target lesion at baseline\\n* ECOG performance status of 0 or 1\\n* Adequate bone marrow reserve and organ function\\n\\nExclusion Criteria:\\n\\n* Prior systemic therapy for advanced/metastatic NSCLC.\\n* Squamous cell histology, or predominantly squamous cell histology NSCLC; mixed small cell lung cancer; NSCLC histology, sarcomatoid variant.\\n* History of another primary malignancy within 3 years\\n* Active or prior documented autoimmune or inflammatory disorders (with exceptions)\\n* Any evidence of severe or uncontrolled disease that makes it undesirable for the participant to participate in the study or that would jeopardies compliance with the protocol.\\n* Has clinically significant third-space fluid retention (for example pleural effusion) and is not amenable for repeated drainage.\\n* History of any ILD/pneumonitis, including radiation pneumonitis (apart from radiation pneumonitis that did not require steroids), or drug-induced ILD/pneumonitis, has current or suspected ILD/pneumonitis that cannot be ruled out by imaging at screening.\\n* Has significant pulmonary function compromise, as determined by the investigator\\n* Spinal cord compression, or brain metastases unless participant treated and no longer symptomatic, radiologically stable, and who require no treatment with corticosteroids or anticonvulsants.\\n* History of leptomeningeal carcinomatosis\\n* Known clinically significant corneal disease\\n* Active infection with TB, HBV, HCV, Hepatitis A, or known HIV infection that is not well controlled\\n* History of active primary immunodeficiency\", \"title\": \"Phase III, Open-label, Study of First-line Dato-DXd in Combination With Rilvegostomig for Advanced Non-squamous NSCLC With High PD-L1 Expression (TC ≥ 50%) and Without Actionable Genomic Alterations\"}, \"terminology\": {\"bundle_id\": \"seed-terminology\", \"bundle_version\": \"0.1.0\", \"licenses\": {\"HGNC\": \"CC0\", \"LOINC\": \"LOINC licence (free, attribution)\", \"SNOMED CT\": \"SNOMED CT affiliate/US NLM licence required; do not redistribute outside authorised boundary\", \"UCUM\": \"UCUM licence (free)\"}, \"sha256\": \"5703d11c29c4233511ce758a38a8cd3e8ea507a541f8f74b31b455f07790733c\", \"stats\": {\"bound\": 4, \"by_relationship\": {\"equivalent\": 1, \"no-map\": 4, \"related\": 3}, \"unmapped\": 4}, \"status\": \"UNREVIEWED_SEED\", \"value_sets\": {}, \"warning\": \"Seed entered by the authoring assistant from general knowledge. No licensed SNOMED CT/UMLS/NCIt/RxNorm access was available. Every code must be verified against the pinned vocabulary release and reviewed (terminology lead) before use. NCIt and UMLS CUI links are intentionally empty.\"}, \"validation\": {\"meaning\": \"NOT validated: clinical + informatics review still required for every executable criterion.\", \"problems\": [], \"structure_ok\": true}}"
   },
