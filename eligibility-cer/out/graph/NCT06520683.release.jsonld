   "cer:header": {
    "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON",
    "@value": "{\"authored_applied\": [\"Inc-b1\", \"Inc-b2\", \"Inc-b4\", \"Inc-b5\", \"Inc-b6\", \"Exc-b1\", \"Exc-b2\", \"Exc-b4\", \"Exc-b5\"], \"completeness_disclosure\": \"Registry-based prescreening: the approved protocol and amendments were not available. A registry excerpt is a discovery source, not proof that all enrollment requirements are present.\", \"conflicts\": [], \"ctrp_biomarker_contract\": {\"note\": \"No CTRP structured biomarker object ingested -> registry biomarker coverage is UNKNOWN, not 'no biomarker restriction'. Biomarker predicates below are interpreted from free text.\", \"status\": \"not_supplied\"}, \"inventory\": {\"criteria_total\": 14, \"exclusion\": 5, \"flagged_nodes\": 2, \"inclusion\": 9, \"leaf_nodes\": 14, \"leaves_by_computability\": {\"structured_computable\": 3, \"text_dependent\": 11}, \"typed_predicates\": 3}, \"lifecycle\": {\"note\": \"Draft only: not reviewed; not executable for screening.\", \"status\": \"draft\"}, \"review_summary\": {\"criteria\": 14, \"open_conflicts\": [], \"pending\": [\"Demo-min-age\", \"Demo-max-age\", \"Inc-b1\", \"Inc-b2\", \"Inc-b3\", \"Inc-b4\", \"Inc-b5\", \"Inc-b6\", \"Inc-b7\", \"Exc-b1\", \"Exc-b2\", \"Exc-b3\", \"Exc-b4\", \"Exc-b5\"], \"validated\": 0}, \"schema_version\": \"cer-draft-0.1\", \"scope_items\": [], \"scopes\": [[]], \"source\": {\"content_sha256\": \"f05717ce38b4935c64afdc24db4f045fee0a35c478d22793c11e6deef40f56c9\", \"demographics\": {\"healthy_volunteers\": false, \"maximum_age\": \"80 Years\", \"minimum_age\": \"18 Years\", \"sex\": \"ALL\"}, \"nct_id\": \"NCT06520683\", \"overall_status\": \"RECRUITING\", \"protocol_baseline\": \"registry_excerpt\", \"registry\": \"ClinicalTrials.gov\", \"retrieved_at\": \"2026-10-06T02:00:00Z\", \"retrieved_via\": \"mcp:Clinical_Trials.get_trial_details\", \"source_role\": \"curated_registry_input (pilot proxy for Source B: the approved protocol document was not available)\", \"source_type\": \"B\", \"text_normalized\": \"Inclusion Criteria:\\n\\n* dMMR and/or MSI-H colorectal carcinoma that undergo surgical resection\\n* Pathologically confirmed as stage II (T3-4,N0), with at least one of the following risk factors: 1) T4 (including T4a and T4b); 2) Vascular invasion; 3) Perineural invasion; 4) Poor differentiation (including mucinous and signet-ring carcinoma); 5) Obstruction and/or perforation before surgery.\\n* Perioperative CT/MR/PET-CT find no signs of metastases\\n* Eastern Cooperative Oncology Group (ECOG) performance status of 0 or 1 within 10 days prior to study start\\n* Aged 18-80\\n* No prior medical therapy (chemotherapy, immunotherapy, biologic or targeted therapy) or radiation therapy for the current cancer\\n* Adequate organ function\\n\\nExclusion Criteria:\\n\\n* Active autoimmune disease that has required systemic treatment in past 2 years\\n* Positive surgical margin (R1/R2 resection)\\n* Presence of post-operative complications that may preclude treatment\\n* Active infection requiring systemic therapy\\n* Any other malignant disease within the preceding 5 years with the exception of non-melanomatous skin cancer, carcinoma in situ and early stage disease with a recurrence risk <5%.\", \"title\": \"Adjuvant PD-1 Blockade for High-risk Stage-II DMMR/MSI-H Colorectal Cancer (SMALLER)\"}, \"terminology\": {\"bundle_id\": \"seed-terminology\", \"bundle_version\": \"0.1.0\", \"licenses\": {\"HGNC\": \"CC0\", \"LOINC\": \"LOINC licence (free, attribution)\", \"SNOMED CT\": \"SNOMED CT affiliate/US NLM licence required; do not redistribute outside authorised boundary\", \"UCUM\": \"UCUM licence (free)\"}, \"sha256\": \"5703d11c29c4233511ce758a38a8cd3e8ea507a541f8f74b31b455f07790733c\", \"stats\": {\"bound\": 2, \"by_relationship\": {\"equivalent\": 1, \"inexact\": 1, \"no-map\": 12}, \"unmapped\": 12}, \"status\": \"UNREVIEWED_SEED\", \"value_sets\": {\"vs:cond-autoimmune\": {\"compose\": [{\"codes\": [\"85828009\"], \"system\": \"SNOMED CT\"}], \"excluded\": [], \"frozen_expansion\": {\"date\": \"2026-10-06\", \"members\": [\"SNOMED CT|85828009\"], \"sha256\": \"cc60190435a7e50d57db7b525bc3fffd2685dd08720225f6f38df6733c334294\"}, \"hierarchy_policy\": \"exact code only (descendant expansion needs a licensed SNOMED release) -> recall may be lower than the clinical intent\", \"id\": \"vs:cond-autoimmune\", \"version\": \"0.1.0\"}}, \"warning\": \"Seed entered by the authoring assistant from general knowledge. No licensed SNOMED CT/UMLS/NCIt/RxNorm access was available. Every code must be verified against the pinned vocabulary release and reviewed (terminology lead) before use. NCIt and UMLS CUI links are intentionally empty.\"}, \"validation\": {\"meaning\": \"NOT validated: clinical + informatics review still required for every executable criterion.\", \"problems\": [], \"structure_ok\": true}}"
   },
