   ],
   "cer:computability": "text_dependent",
   "cer:displayNumber": "Inc-b10",
   "cer:extra": {
    "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON",
    "@value": "{\"concept_hits\": [\"autoimmune\"], \"review\": {}}"
   },
