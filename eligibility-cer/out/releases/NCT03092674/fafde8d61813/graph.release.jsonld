   "cer:scope": {
    "@list": []
   },
   "cer:sourceText": "REGISTRATION STEP 2-RANDOMIZATION: Prior treatment with hydroxyurea is permitted; prior all-trans retinoic acid (ATRA) for suspected APL and prior intrathecal therapy are permitted, but must plan to be discontinued prior to initiating protocol therapy; patients with signs/symptoms of hyperleukocytosis or white blood cells (WBC) >= 50,000/mcL can be treated with leukapheresis prior to randomization (registration to Step 2)",
   "cer:subtype": "prior therapy / medication",
   "prov:wasDerivedFrom": {
    "@id": "_:cb123c96cac64c307864dcc6de994db3a9780f02a8e45fe00928abce3f5a2e9b702"
   },
