   "cer:path": "/inc/9",
   "cer:polarity": "inclusion",
   "cer:polarityBasis": "section 'inclusion'",
   "cer:reviewStatus": "needs_review",
   "cer:scope": {
    "@list": []
   },
   "cer:sourceText": "Organ function meeting the following criteria at screening: a.Blood routine: neutrophil (ANC) ≥ 1.5 × 109/L, platelet (PLT) ≥ 100 × 109/L, hemoglobin (Hb) ≥ 90 g/L; b.Liver function: total bilirubin (TBIL) ≤ 1.0 × upper limit of normal (ULN); aspartate aminotransferase (AST) and alanine aminotransferase (ALT) ≤ 2.0 × ULN; if liver metastases, AST and ALT ≤ 3 × ULN; serum albumin ≥ 30 g/L; c.Renal function: serum creatinine ≤ 1.5 × ULN or creatinine clearance ≥ 40 mL/min; d.Coagulation function: Prothrombin time - international normalized ratio (PT-INR) < 1.5;",
   "prov:wasDerivedFrom": {
    "@id": "_:cb1c12674d5aba17d86f5bae14fe202ac16b2b3d8e0b8decdbd183da7c14e384eb7"
   },
