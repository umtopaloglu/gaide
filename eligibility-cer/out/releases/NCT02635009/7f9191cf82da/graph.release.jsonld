   "cer:reviewStatus": "needs_review",
   "cer:sourceText": "Note: Patients who are HIV positive are eligible, provided they are under treatment with highly active antiretroviral therapy (HAART) and have a CD4 count ≥ 200 cells/microliter within 30 days prior to Step 1 registration.",
   "cer:subtype": "prior therapy / medication",
